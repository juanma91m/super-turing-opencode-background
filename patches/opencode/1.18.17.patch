+export function agentModelVariantKey(
+  agentName: string | undefined,
+  model: { providerID: string; modelID: string } | undefined,
+) {
+  if (!agentName || !model) return undefined
+  return `${agentName}/${model.providerID}/${model.modelID}`
+}
+
+export function configuredAgentVariant(
+  agent: { variant?: string; model?: { providerID: string; modelID?: string; id?: string } } | undefined,
+  model: { providerID: string; modelID: string } | undefined,
+) {
+  if (!agent?.variant || !agent.model || !model) return undefined
+  const agentModelID = agent.model.modelID ?? agent.model.id
+  if (agent.model.providerID !== model.providerID || agentModelID !== model.modelID) return undefined
+  return agent.variant
+}
+
+export function selectModelVariant(input: {
+  agent?: { name?: string; variant?: string; model?: { providerID: string; modelID?: string; id?: string } }
+  model?: { providerID: string; modelID: string }
+  variants: string[]
+  overrides: Record<string, string | undefined>
+}) {
+  const key = agentModelVariantKey(input.agent?.name, input.model)
+  const selected = key ? input.overrides[key] : undefined
+  const configured = configuredAgentVariant(input.agent, input.model)
+  const current = selected ?? configured
+  return {
+    selected,
+    configured,
+    current: current && input.variants.includes(current) ? current : undefined,
+  }
+}
