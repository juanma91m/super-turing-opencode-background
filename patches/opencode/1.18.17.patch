+const sessionAdapters: SessionAdapterEntry[] = []
+const sessionAdapterListeners = new Set<() => void>()
+let sessionAdapterOrder = 0
+const sessionListAdapters: SessionListAdapterEntry[] = []
+const sessionListAdapterListeners = new Set<() => void>()
+let sessionListAdapterOrder = 0
+
+function sessionAdapterNotify() {
+  for (const listener of sessionAdapterListeners) listener()
+}
+
+function sessionListAdapterNotify() {
+  for (const listener of sessionListAdapterListeners) listener()
+}
+
+function sessionAdapterRegister(adapter: TuiSessionAdapter) {
+  const key = Symbol()
+  sessionAdapters.push({ key, order: sessionAdapterOrder++, adapter })
+  sessionAdapterNotify()
+
+  return () => {
+    const index = sessionAdapters.findIndex((entry) => entry.key === key)
+    if (index === -1) return
+    sessionAdapters.splice(index, 1)
+    sessionAdapterNotify()
+  }
