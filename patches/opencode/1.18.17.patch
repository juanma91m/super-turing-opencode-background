+
+function sessionListAdapterRegister(adapter: TuiSessionListAdapter) {
+  const key = Symbol()
+  sessionListAdapters.push({ key, order: sessionListAdapterOrder++, adapter })
+  sessionListAdapterNotify()
+
+  return () => {
