@@ -0,0 +1,666 @@
+import * as crypto from "node:crypto"
+import * as fs from "node:fs/promises"
+import * as os from "node:os"
+import * as path from "node:path"
+import type { Message, Part } from "@opencode-ai/sdk/v2"
+import type { TuiPlugin, TuiPluginApi, TuiPluginModule } from "@opencode-ai/plugin/tui"
+import { createMemo, createSignal, For, onCleanup, onMount, Show } from "solid-js"
+
+const id = "internal:sidebar-background-tasks"
+const SESSION_STATE_PREFIX = "background-agents-tui"
+const POLL_INTERVAL_MS = 2500
+const VISIBLE_LIMIT = 5
+
+type TaskSource = "delegation" | "session-run"
+
+type PersistedDelegationMeta = {
+  id: string
+  mode: "read-only" | "isolated-write"
+  sessionID?: string | null
+  agent: string
+  status: string
+  queuedAt?: string | null
+  startedAt?: string | null
+  completedAt?: string | null
+  error?: string | null
+  title?: string | null
+  description?: string | null
+  promptPreview?: string | null
+  artifactsDir?: string | null
+}
+
+type SessionRunRef = {
+  id: string
+  source: "foreground-detach" | "prompt-async"
+  sequence?: number
+  title?: string
+  bgTaskToken?: string
+  inspectionHostSessionID?: string
+  parentUserMessageID?: string
+  assistantMessageID?: string
+  createdAt: number
+  detachedAt: number
+}
+
+type SessionBackgroundState = {
+  backgroundModeEnabled: boolean
+  trackedTaskRefs: SessionRunRef[]
+  threadRootSessionID?: string
+}
+
+type BackgroundThreadState = {
+  rootSessionID: string
+  foregroundSessionID: string
+  title?: string
+}
+
+type TaskRecord = {
+  id: string
+  source: TaskSource
+  sessionID?: string
+  sequence?: number
+  displaySequence?: number
+  agent?: string
+  title?: string
+  status: string
+  mode: string
+  description?: string
+  promptPreview?: string
+  error?: string
+  queuedAt?: string
+  startedAt?: string
+  completedAt?: string
+  updatedAt?: string
+  artifactsDir?: string
+  parentUserMessageID?: string
+  assistantMessageID?: string
+  inspectionHostSessionID?: string
+  currentSession?: boolean
+}
+
+type Snapshot = {
+  projectId?: string
+  title?: string
+  items: TaskRecord[]
+}
+
+type SessionMessageRecord = {
+  info: Message
+  parts: Part[]
+}
+
+function normalizePositiveInt(value: unknown): number | undefined {
+  const number = Number(value)
+  return Number.isInteger(number) && number > 0 ? number : undefined
+}
+
+function hashString(input: string): string {
+  return crypto.createHash("sha256").update(input).digest("hex").slice(0, 16)
+}
+
+class TimeoutError extends Error {
+  override readonly name = "TimeoutError" as const
+}
+
+async function withTimeout<T>(promise: Promise<T>, ms: number, message: string): Promise<T> {
+  let timeoutId: ReturnType<typeof setTimeout>
+  return Promise.race([
+    promise.finally(() => clearTimeout(timeoutId)),
+    new Promise<never>((_, reject) => {
+      timeoutId = setTimeout(() => reject(new TimeoutError(message)), ms)
+    }),
+  ])
+}
+
+async function getProjectId(projectRoot: string): Promise<string> {
+  try {
+    const proc = Bun.spawn(["git", "rev-list", "--max-parents=0", "--all"], {
+      cwd: projectRoot,
+      stdout: "pipe",
+      stderr: "pipe",
+    })
+    const exitCode = await withTimeout(proc.exited, 5000, "git rev-list timed out").catch((err) => {
+      if (err instanceof TimeoutError) proc.kill()
+      return 1
+    })
+    if (exitCode === 0) {
+      const output = await new Response(proc.stdout).text()
+      const roots = output
+        .split("\n")
+        .map((line) => line.trim())
+        .filter(Boolean)
+        .sort()
+      if (roots.length > 0) return roots[0].slice(0, 16)
+    }
+  } catch {
+    // fall through
+  }
+  return hashString(projectRoot)
+}
+
+function summarize(text: string | undefined, max = 120): string | undefined {
+  if (!text) return undefined
+  const normalized = text.replace(/\s+/g, " ").trim()
+  if (!normalized) return undefined
+  return normalized.length > max ? `${normalized.slice(0, max).trim()}...` : normalized
+}
+
+function normalizeDisplaySummary(text: string | undefined): string | undefined {
+  if (!text) return undefined
+  const normalized = text.replace(/^\s*quiero(?:\s+que|\s+una|\s+un)?\s+/i, "").trim()
+  return normalized || undefined
+}
+
+function displayTaskTitle(item: TaskRecord, icon: string): string {
+  const fallback = item.source === "delegation" ? "Delegación background" : "Tarea en background"
+  const summary = summarize(normalizeDisplaySummary(item.title) || fallback, 25) || fallback
+  const sequence = normalizePositiveInt(item.displaySequence) || normalizePositiveInt(item.sequence)
+  return sequence ? `${icon} #${sequence} — ${summary}` : `${icon} ${summary}`
+}
+
+function sortKey(item: TaskRecord): string {
+  return item.completedAt || item.startedAt || item.queuedAt || item.updatedAt || item.id
+}
+
+function displayOrderKey(item: TaskRecord): string {
+  return item.queuedAt || item.startedAt || item.updatedAt || item.completedAt || item.id
+}
+
+function compareTaskDialogOrder(a: TaskRecord, b: TaskRecord): number {
+  const aSequence = a.source === "session-run" ? normalizePositiveInt(a.sequence) : undefined
+  const bSequence = b.source === "session-run" ? normalizePositiveInt(b.sequence) : undefined
+  if (aSequence !== undefined && bSequence !== undefined && aSequence !== bSequence) return aSequence - bSequence
+  const aOrder = displayOrderKey(a)
+  const bOrder = displayOrderKey(b)
+  if (aOrder !== bOrder) return aOrder.localeCompare(bOrder)
+  if (a.source !== b.source) return a.source.localeCompare(b.source)
+  return a.id.localeCompare(b.id)
+}
+
+function getStatusPresentation(status: TaskRecord["status"]) {
+  switch (status) {
+    case "queued":
+      return { icon: "🟡", label: "encolada" }
+    case "running":
+      return { icon: "🔵", label: "corriendo" }
+    case "done":
+      return { icon: "🟢", label: "completada" }
+    case "needs_input":
+      return { icon: "🟠", label: "necesita input" }
+    case "error":
+    default:
+      return { icon: "🔴", label: "error" }
+  }
+}
+
+function toIsoTime(value?: number | string): string | undefined {
+  if (value === undefined || value === null) return undefined
+  if (typeof value === "string") return value
+  return new Date(value).toISOString()
+}
+
+function buildSessionStateKey(sessionID: string): string {
+  return `${SESSION_STATE_PREFIX}:session:${sessionID}`
+}
+
+function buildThreadStateKey(rootSessionID: string): string {
+  return `${SESSION_STATE_PREFIX}:thread:${rootSessionID}`
+}
+
+function buildInspectionStateKey(): string {
+  return `${SESSION_STATE_PREFIX}:inspection`
+}
+
+function normalizeSessionBackgroundState(value: unknown): SessionBackgroundState {
+  const input = value && typeof value === "object" ? (value as Partial<SessionBackgroundState>) : {}
+  const refs = Array.isArray(input.trackedTaskRefs)
+    ? input.trackedTaskRefs
+        .filter((ref): ref is SessionRunRef => Boolean(ref && typeof ref === "object" && typeof (ref as SessionRunRef).id === "string"))
+        .map((ref) => ({
+          id: ref.id,
+          source: (ref.source === "foreground-detach" ? "foreground-detach" : "prompt-async") as SessionRunRef["source"],
+          sequence: normalizePositiveInt(ref.sequence),
+          title: ref.title,
+          bgTaskToken: ref.bgTaskToken,
+          inspectionHostSessionID: ref.inspectionHostSessionID,
+          parentUserMessageID: ref.parentUserMessageID,
+          assistantMessageID: ref.assistantMessageID,
+          createdAt: Number(ref.createdAt || Date.now()),
+          detachedAt: Number(ref.detachedAt || ref.createdAt || Date.now()),
+        }))
+    : []
+  const unique = new Map<string, SessionRunRef>()
+  for (const ref of refs) unique.set(ref.id, ref)
+  return {
+    backgroundModeEnabled: Boolean(input.backgroundModeEnabled),
+    trackedTaskRefs: Array.from(unique.values()).sort((a, b) => b.detachedAt - a.detachedAt),
+    threadRootSessionID:
+      typeof input.threadRootSessionID === "string" && input.threadRootSessionID.trim() ? input.threadRootSessionID.trim() : undefined,
+  }
+}
+
+function normalizeThreadState(value: unknown, fallbackRootSessionID: string): BackgroundThreadState {
+  const input = value && typeof value === "object" ? (value as Partial<BackgroundThreadState>) : {}
+  return {
+    rootSessionID:
+      typeof input.rootSessionID === "string" && input.rootSessionID.trim() ? input.rootSessionID.trim() : fallbackRootSessionID,
+    foregroundSessionID:
+      typeof input.foregroundSessionID === "string" && input.foregroundSessionID.trim()
+        ? input.foregroundSessionID.trim()
+        : fallbackRootSessionID,
+    title: typeof input.title === "string" && input.title.trim() ? input.title.trim() : undefined,
+  }
+}
+
+function loadSessionState(api: TuiPluginApi, sessionID: string): SessionBackgroundState {
+  return normalizeSessionBackgroundState(api.kv.get(buildSessionStateKey(sessionID), undefined))
+}
+
+function saveSessionState(api: TuiPluginApi, sessionID: string, state: SessionBackgroundState) {
+  api.kv.set(buildSessionStateKey(sessionID), normalizeSessionBackgroundState(state))
+}
+
+function loadThreadState(api: TuiPluginApi, rootSessionID: string): BackgroundThreadState {
+  return normalizeThreadState(api.kv.get(buildThreadStateKey(rootSessionID), undefined), rootSessionID)
+}
+
+function saveInspectionState(api: TuiPluginApi, state: Record<string, unknown> | undefined) {
+  api.kv.set(buildInspectionStateKey(), state)
+}
+
+function resolveThreadRootSessionID(state: SessionBackgroundState, sessionInfo: { id: string; parentID?: string }): string {
+  return state.threadRootSessionID || sessionInfo.parentID || sessionInfo.id
+}
+
+function resolveShellSessionID(api: TuiPluginApi, sessionID?: string): string | undefined {
+  if (!sessionID) return undefined
+  const state = loadSessionState(api, sessionID)
+  return state.threadRootSessionID || sessionID
+}
+
+async function fetchSessionInfo(api: TuiPluginApi, sessionID: string) {
+  const result = await api.client.session.get({ sessionID }).catch(() => undefined)
+  return result?.data as { id: string; parentID?: string; title?: string } | undefined
+}
+
+async function fetchSessionMessages(api: TuiPluginApi, sessionID: string) {
+  const result = await api.client.session.messages({ sessionID, limit: 200 }).catch(() => undefined)
+  return (result?.data ?? []) as SessionMessageRecord[]
+}
+
+function summarizeMessageParts(parts: Part[]): string | undefined {
+  const text = parts
+    .filter((part) => part.type === "text")
+    .map((part) => String((part as any).text ?? ""))
+    .join(" ")
+  return summarize(text)
+}
+
+function extractBackgroundToken(parts: Part[]): string | undefined {
+  for (const part of parts) {
+    if (part.type !== "text") continue
+    const token = (part as any).metadata?.bgTaskToken
+    if (typeof token === "string" && token.trim()) return token.trim()
+  }
+  return undefined
+}
+
+function buildStatus(input: { assistant?: Message; hasPendingInput: boolean }): TaskRecord["status"] {
+  const assistant = input.assistant as (Message & { error?: unknown; time?: { completed?: number } }) | undefined
+  if (assistant?.error) return "error"
+  if (!assistant) return "queued"
+  if (assistant.time?.completed) return "done"
+  if (input.hasPendingInput) return "needs_input"
+  return "running"
+}
+
+async function readProjectDelegations(
+  projectDirectory: string,
+  allowedParentSessionIDs?: ReadonlySet<string>,
+) {
+  const projectId = await getProjectId(projectDirectory)
+  const baseDir = path.join(os.homedir(), ".local", "share", "opencode", "delegations", projectId)
+  const items: TaskRecord[] = []
+
+  try {
+    const sessionDirs = await fs.readdir(baseDir, { withFileTypes: true })
+    for (const sessionDir of sessionDirs) {
+      if (!sessionDir.isDirectory()) continue
+      if (allowedParentSessionIDs && !allowedParentSessionIDs.has(sessionDir.name)) continue
+      const sessionPath = path.join(baseDir, sessionDir.name)
+      const delegationDirs = await fs.readdir(sessionPath, { withFileTypes: true }).catch(() => [])
+      for (const delegationDir of delegationDirs) {
+        if (!delegationDir.isDirectory()) continue
+        const metaPath = path.join(sessionPath, delegationDir.name, "meta.json")
+        try {
+          const raw = await fs.readFile(metaPath, "utf8")
+          const meta = JSON.parse(raw) as PersistedDelegationMeta
+          items.push({
+            id: meta.id,
+            source: "delegation",
+            status: meta.status,
+            mode: meta.mode,
+            sessionID: meta.sessionID ?? undefined,
+            agent: meta.agent,
+            title: meta.title ?? meta.description ?? meta.promptPreview ?? undefined,
+            description: meta.description ?? meta.promptPreview ?? undefined,
+            promptPreview: meta.promptPreview ?? undefined,
+            error: meta.error ?? undefined,
+            queuedAt: meta.queuedAt ?? undefined,
+            startedAt: meta.startedAt ?? undefined,
+            completedAt: meta.completedAt ?? undefined,
+            updatedAt: meta.completedAt ?? meta.startedAt ?? meta.queuedAt ?? undefined,
+            artifactsDir: meta.artifactsDir ?? undefined,
+          })
+        } catch {
+          // ignore malformed or transient files
+        }
+      }
+    }
+  } catch {
+    // ignore missing delegation dir
+  }
+
+  items.sort((a, b) => sortKey(b).localeCompare(sortKey(a)))
+  return { projectId, items }
+}
+
+async function resolveLiveDelegationTask(api: TuiPluginApi, item: TaskRecord) {
+  if (!item.sessionID) return item
+
+  const messages = await fetchSessionMessages(api, item.sessionID).catch(() => undefined)
+  if (!messages) return item
+
+  const assistant = messages
+    .filter((message): message is SessionMessageRecord => message.info.role === "assistant")
+    .at(-1)
+  const assistantInfo = assistant?.info as (Message & { time?: { created?: number; completed?: number } }) | undefined
+  const hasPendingInput =
+    api.state.session.permission(item.sessionID).length > 0 ||
+    api.state.session.question(item.sessionID).length > 0
+
+  return {
+    ...item,
+    status: buildStatus({ assistant: assistantInfo, hasPendingInput }),
+    startedAt: item.startedAt || toIsoTime(assistantInfo?.time?.created),
+    completedAt: item.completedAt || toIsoTime(assistantInfo?.time?.completed),
+    updatedAt:
+      toIsoTime(assistantInfo?.time?.completed) ||
+      toIsoTime(assistantInfo?.time?.created) ||
+      item.updatedAt ||
+      item.startedAt ||
+      item.queuedAt ||
+      item.id,
+  }
+}
+
+async function buildSnapshot(api: TuiPluginApi, sessionID: string): Promise<Snapshot> {
+  const sessionInfo = await fetchSessionInfo(api, sessionID)
+  if (!sessionInfo?.id) return { items: [] }
+
+  const currentState = loadSessionState(api, sessionID)
+  const rootSessionID = resolveThreadRootSessionID(currentState, sessionInfo)
+  const threadState = loadThreadState(api, rootSessionID)
+  const sessionsResult = await api.client.session.list({
+    directory: api.state.path.directory || api.state.path.worktree || process.cwd(),
+    limit: 200,
+  })
+  const sessions = (sessionsResult?.data ?? []) as Array<{ id: string; parentID?: string }>
+  const threadSessionIDs = sessions.filter((item) => item.id === rootSessionID || item.parentID === rootSessionID).map((item) => item.id)
+  if (!threadSessionIDs.includes(rootSessionID)) threadSessionIDs.unshift(rootSessionID)
+  const delegationParentSessionIDs = new Set(threadSessionIDs)
+  if (threadState.foregroundSessionID) delegationParentSessionIDs.add(threadState.foregroundSessionID)
+  const backgroundSessionIDs = threadSessionIDs.filter((candidate) => candidate !== threadState.foregroundSessionID)
+
+  const sessionItems: TaskRecord[] = []
+  for (const candidateSessionID of backgroundSessionIDs) {
+    const state = loadSessionState(api, candidateSessionID)
+    if (!state.trackedTaskRefs.length) continue
+
+    const messages = await fetchSessionMessages(api, candidateSessionID)
+    const userMessages = new Map<string, SessionMessageRecord>()
+    const assistantByParent = new Map<string, SessionMessageRecord>()
+    for (const message of messages) {
+      if (message.info.role === "user") userMessages.set(message.info.id, message)
+      if (message.info.role === "assistant") {
+        const parentID = (message.info as Message & { parentID?: string }).parentID
+        if (!parentID) continue
+        const previous = assistantByParent.get(parentID)
+        const previousCreated = Number(previous?.info.time?.created ?? 0)
+        const currentCreated = Number(message.info.time?.created ?? 0)
+        if (!previous || currentCreated >= previousCreated) assistantByParent.set(parentID, message)
+      }
+    }
+
+    const hasPendingInput = api.state.session.permission(candidateSessionID).length > 0 || api.state.session.question(candidateSessionID).length > 0
+
+    for (const ref of state.trackedTaskRefs) {
+      let userRecord = ref.parentUserMessageID ? userMessages.get(ref.parentUserMessageID) : undefined
+      if (!userRecord && ref.bgTaskToken) {
+        userRecord = Array.from(userMessages.values()).find((item) => extractBackgroundToken(item.parts) === ref.bgTaskToken)
+      }
+      const parentUserMessageID = userRecord?.info.id ?? ref.parentUserMessageID
+      const assistantRecord = parentUserMessageID ? assistantByParent.get(parentUserMessageID) : undefined
+      const assistantInfo = assistantRecord?.info as (Message & { time?: { created?: number; completed?: number } }) | undefined
+      sessionItems.push({
+        id: ref.id,
+        source: "session-run",
+        sessionID: candidateSessionID,
+        sequence: ref.sequence,
+        title: ref.title || summarizeMessageParts(userRecord?.parts ?? []) || "Tarea en background",
+        status: buildStatus({ assistant: assistantRecord?.info, hasPendingInput }),
+        mode: "same-session",
+        queuedAt: toIsoTime(ref.createdAt),
+        startedAt: toIsoTime(assistantInfo?.time?.created),
+        completedAt: toIsoTime(assistantInfo?.time?.completed),
+        updatedAt:
+          toIsoTime(assistantInfo?.time?.completed) ||
+          toIsoTime(assistantInfo?.time?.created) ||
+          toIsoTime(ref.detachedAt),
+        parentUserMessageID,
+        assistantMessageID: assistantRecord?.info.id ?? ref.assistantMessageID,
+        inspectionHostSessionID: ref.inspectionHostSessionID,
+        currentSession: candidateSessionID === sessionID,
+      })
+    }
+  }
+
+  const delegationSnapshot = await readProjectDelegations(api.state.path.directory || api.state.path.worktree || process.cwd(), delegationParentSessionIDs)
+  const delegationItems = await Promise.all(delegationSnapshot.items.map((item) => resolveLiveDelegationTask(api, item)))
+
+  const items = [...sessionItems, ...delegationItems]
+    .sort(compareTaskDialogOrder)
+    .map((item, index) => ({
+      ...item,
+      displaySequence: index + 1,
+    }))
+    .slice()
+    .sort((a, b) => sortKey(b).localeCompare(sortKey(a)))
+
+  return {
+    projectId: delegationSnapshot.projectId,
+    title: threadState.title,
+    items,
+  }
+}
+
+async function readDelegationPersistedExcerpt(task: TaskRecord): Promise<string | undefined> {
+  if (!task.artifactsDir) return summarize(task.description || task.promptPreview || task.title, 600)
+  try {
+    const result = (await fs.readFile(path.join(task.artifactsDir, "result.md"), "utf8")).trim()
+    if (result) return summarize(result, 600)
+  } catch {
+    // ignore missing persisted result
+  }
+  return summarize(task.description || task.promptPreview || task.title, 600)
+}
+
+async function ensureInspectionHostSession(api: TuiPluginApi, task: TaskRecord, returnSessionID?: string): Promise<string> {
+  if (!task.sessionID) return returnSessionID || ""
+  if (!returnSessionID || task.sessionID !== returnSessionID) return task.sessionID
+
+  const state = loadSessionState(api, task.sessionID)
+  const ref = state.trackedTaskRefs.find(
+    (candidate) =>
+      candidate.id === task.id ||
+      (task.parentUserMessageID && candidate.parentUserMessageID === task.parentUserMessageID) ||
+      (task.assistantMessageID && candidate.assistantMessageID === task.assistantMessageID),
+  )
+  if (ref?.inspectionHostSessionID) {
+    const existing = await fetchSessionInfo(api, ref.inspectionHostSessionID)
+    if (existing?.id) return existing.id
+  }
+
+  const created = await api.client.session.create({ parentID: returnSessionID, title: task.title || "Vista background" }).catch(() => undefined)
+  const hostSessionID = created?.data?.id as string | undefined
+  if (!hostSessionID) return task.sessionID
+
+  const hostState = loadSessionState(api, hostSessionID)
+  hostState.backgroundModeEnabled = false
+  hostState.threadRootSessionID = returnSessionID
+  saveSessionState(api, hostSessionID, hostState)
+
+  if (ref) {
+    ref.inspectionHostSessionID = hostSessionID
+    saveSessionState(api, task.sessionID, state)
+  }
+  return hostSessionID
+}
+
+function View(props: { api: TuiPluginApi; session_id: string }) {
+  const [open, setOpen] = createSignal(true)
+  const [snapshot, setSnapshot] = createSignal<Snapshot>({ items: [] })
+  const theme = () => props.api.theme.current
+  const visibleItems = createMemo(() => snapshot().items.slice(-VISIBLE_LIMIT).reverse())
+  const hiddenCount = createMemo(() => Math.max(snapshot().items.length - visibleItems().length, 0))
+
+  const refresh = async () => {
+    const shellSessionID = resolveShellSessionID(props.api, props.session_id) || props.session_id
+    setSnapshot(await buildSnapshot(props.api, shellSessionID))
+  }
+
+  const openTask = async (task: TaskRecord) => {
+    const currentRoute = props.api.route.current
+    const currentRouteID = currentRoute.name === "session" ? String(currentRoute.params?.sessionID) : undefined
+    const returnSessionID = resolveShellSessionID(props.api, currentRouteID) || currentRouteID || task.sessionID
+    const openFallbackAlert = async () => {
+      const message =
+        task.source === "delegation"
+          ? (() =>
+              readDelegationPersistedExcerpt(task).then((excerpt) =>
+                excerpt
+                  ? `La sesión hija ya no está disponible, pero quedó resultado persistido.\n\n${excerpt}\n\nUsá delegation_read("${task.id}") desde la sesión actual si necesitás el detalle completo.`
+                  : `Usá delegation_read("${task.id}") desde la sesión actual para inspeccionar el resultado persistido.`,
+              ))()
+          : Promise.resolve(
+              task.status === "needs_input"
+                ? "Esta tarea de la misma sesión está esperando input del usuario o un permiso en la sesión actual."
+                : "Esta tarea background pertenece a la sesión actual; inspeccioná la conversación para ver el detalle.",
+            )
+      const resolvedMessage = await message
+      props.api.ui.dialog.replace(() =>
+        props.api.ui.DialogAlert({
+          title:
+            task.source === "delegation"
+              ? "La sesión hija ya no está disponible"
+              : "Tarea de la sesión actual",
+          message: resolvedMessage,
+        }),
+      )
+    }
+
+    if (task.source === "delegation") {
+      if (!task.sessionID) {
+        await openFallbackAlert()
+        return
+      }
+      const selectedInfo = await fetchSessionInfo(props.api, task.sessionID)
+      if (!selectedInfo?.id) {
+        await openFallbackAlert()
+        return
+      }
+      const hostSessionID = task.sessionID
+      saveInspectionState(props.api, {
+        sessionID: hostSessionID,
+        sourceSessionID: task.sessionID,
+        returnSessionID: returnSessionID || undefined,
+        taskSource: "delegation",
+        taskID: task.id,
+      })
+      if (hostSessionID && hostSessionID !== currentRouteID) props.api.route.navigate("session", { sessionID: hostSessionID })
+      return
+    }
+
+    if (!task.sessionID) {
+      await openFallbackAlert()
+      return
+    }
+
+    const hostSessionID = await ensureInspectionHostSession(props.api, task, returnSessionID)
+    saveInspectionState(props.api, {
+      sessionID: hostSessionID,
+      sourceSessionID: task.sessionID,
+      returnSessionID: returnSessionID || undefined,
+      taskSource: "session-run",
+      taskID: task.id,
+      parentUserMessageID: task.parentUserMessageID,
+      assistantMessageID: task.assistantMessageID,
+    })
+    if (hostSessionID && hostSessionID !== currentRouteID) props.api.route.navigate("session", { sessionID: hostSessionID })
+  }
+
+  onMount(() => {
+    void refresh()
+    const interval = setInterval(() => void refresh(), POLL_INTERVAL_MS)
+    onCleanup(() => clearInterval(interval))
+  })
+
+  return (
+    <box>
+      <box flexDirection="row" gap={1} onMouseDown={() => setOpen((value) => !value)}>
+        <text fg={theme().text}>{open() ? "▼" : "▶"}</text>
+        <text fg={theme().text}>
+          <b>Background Tasks</b>
+        </text>
+      </box>
+      <Show when={open()}>
+        <Show when={snapshot().items.length === 0}>
+          <text fg={theme().textMuted}>No background tasks for this session.</text>
+        </Show>
+        <For each={visibleItems()}>
+          {(item) => {
+            const presentation = createMemo(() => getStatusPresentation(item.status))
+            return (
+              <box flexDirection="column" onMouseUp={() => void openTask(item)}>
+                <text fg={theme().text} wrapMode="word">
+                  {displayTaskTitle(item, presentation().icon)}
+                </text>
+              </box>
+            )
+          }}
+        </For>
+        <Show when={hiddenCount() > 0}>
+          <text fg={theme().textMuted} onMouseDown={() => props.api.keymap.dispatchCommand("bg-tasks")}>+{hiddenCount()} more · /bg-tasks</text>
+        </Show>
+      </Show>
+    </box>
+  )
+}
+
+const tui: TuiPlugin = async (api) => {
+  api.slots.register({
+    order: 350,
+    slots: {
+      sidebar_content(_ctx, props) {
+        return <View api={api} session_id={props.session_id} />
+      },
+    },
+  })
+}
+
+const plugin: TuiPluginModule & { id: string } = {
+  id,
+  tui,
+}
+
+export default plugin
